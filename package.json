{
  "name": "tabcraft",
  "displayName": "TabCraft - AI Tab Manager",
  "version": "0.1.9",
  "description": "AI tab organizer for Chrome — auto-groups by topic, hibernates inactive tabs, removes duplicates. 100% private, on-device AI.",
  "author": "TabCraft Contributors",
  "license": "MIT",
  "homepage": "https://github.com/alloevil/tabcraft",
  "repository": {
    "type": "git",
    "url": "https://github.com/alloevil/tabcraft.git"
  },
  "bugs": {
    "url": "https://github.com/alloevil/tabcraft/issues"
  },
  "keywords": [
    "chrome-extension",
    "tab-manager",
    "tab-groups",
    "ai",
    "gemini-nano",
    "productivity",
    "tab-hibernation",
    "duplicate-tabs",
    "browser-extension",
    "open-source"
  ],
  "type": "module",
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "plasmo": "^0.89.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tldts": "^7.4.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "content-security-policy-parser": "^0.6.0",
    "msgpackr": "^1.10.1",
    "sharp": "^0.35.0",
    "svelte": "^5.55.7",
    "tmp": "^0.2.6",
    "tsup": {
      ".": "^8.5.0",
      "esbuild": "^0.28.1"
    }
  },
  "manifest": {
    "permissions": [
      "tabs",
      "tabGroups",
      "storage",
      "sidePanel",
      "contextMenus",
      "alarms",
      "scripting"
    ],
    "optional_host_permissions": [
      "<all_urls>"
    ],
    "commands": {
      "smart-group": {
        "suggested_key": {
          "default": "Ctrl+Shift+G",
          "mac": "Command+Shift+G"
        },
        "description": "Smart group all tabs"
      },
      "close-duplicates": {
        "suggested_key": {
          "default": "Ctrl+Shift+D",
          "mac": "Command+Shift+D"
        },
        "description": "Close duplicate tabs"
      }
    }
  }
}
